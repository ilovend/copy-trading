# ============================================================
#  币安跟单监听 · 环境配置
#  复制本文件为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交
# ============================================================

# ------------------------------------------------------------
# 【必填】Telegram 机器人
# ------------------------------------------------------------
# 1) Telegram 搜 @BotFather -> /newbot -> 按提示起名
#    拿到形如 123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx 的 token
# 2) 打开你的机器人，随便发一句话（否则收不到消息）
TELEGRAM_BOT_TOKEN=

# 你的 chat id：Telegram 搜 @userinfobot，发任意消息，它会回一个数字
# 也可以浏览器打开 https://api.telegram.org/bot<TOKEN>/getUpdates 里找 "chat":{"id":...}
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# 【可选】Telegram 代理
# ------------------------------------------------------------
# 国内直连 api.telegram.org 通常不通，填本地代理端口可显著提速
# 留空 = 直连
# 例：http://127.0.0.1:7890
TELEGRAM_PROXY=

# ------------------------------------------------------------
# 【可选】兜底组合 ID
# ------------------------------------------------------------
# 正常情况下程序启动时自动拉取你所有跟单组合（copy-portfolio/detail-list），
# 不需要填这一项。
# 只有自动发现失败（例如接口改版）时，才会退化成只监听这里填的单个组合。
# 在“跟单管理”页面地址栏或抓包里可以看到 copyPortfolioId（19 位数字）。
COPY_PORTFOLIO_ID=

# ------------------------------------------------------------
# 【可选】只监听其中几个带单员
# ------------------------------------------------------------
# 三项都留空 = 监听全部（默认）。填任意一项即进入"筛选模式"，
# 命中规则（满足一个即可）：组合ID相等 / 带单员ID相等 / 名字包含该关键词。
# 多个值用英文逗号分隔。
#
# 例：只监听"玄冥二老"和"星辰社区-海"
#   WATCH_NICKNAMES=玄冥二老,星辰社区-海
# 例：只监听名字里带"星辰社区"的三个人
#   WATCH_NICKNAMES=星辰社区
# 例：按 ID 精确指定
#   WATCH_LEADS=4908633203782592768,5131925334830383361
WATCH_NICKNAMES=
WATCH_LEADS=
WATCH_PORTFOLIOS=

# ------------------------------------------------------------
# 【可选】直接在 .env 里填登录态（替代 probe/session.json）
# ------------------------------------------------------------
# 推荐用 `python bot\update_session.py --clipboard` 自动生成 session.json，
# 手抄 cookie 容易出错。若确实想集中放在 .env，填下面两项即可：
#   - 两项必须同时填，只填 cookie 会返回 401
#   - 值里不要加引号，原样粘贴
# 填了这两项后，.env 优先于 session.json。
#
# 获取：F12 -> Network -> 刷新 copy-management -> 任一 copy-portfolio 请求
#       -> Copy as cURL，从里面找 `cookie:` 和 `csrftoken:` 两个头
BINANCE_COOKIE=
BINANCE_CSRFTOKEN=

# 可选：自定义 User-Agent（一般不用填，跟随 session.json）
BINANCE_UA=
